{
  "name": "create-fc-docs",
  "private": true,
  "type": "module",
  "description": "The create-fc docs site (VitePress). Source in docs/, built into site/docs/ for GitHub Pages.",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "brand:build": "node brand/scripts/build.mjs",
    "avatars:build": "node client/logo/scripts/build-avatars.cjs",
    "site:dev": "vite site --port 5173 --strictPort --open /next/",
    "seed-card:render": "node brand/scripts/render-seed-card.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.2.5",
    "opentype.js": "1.3.4",
    "playwright": "1.63.0",
    "vite": "8.3.3",
    "vitepress": "1.6.4"
  }
}
