#!/bin/bash
# fc-node: check on a read node set up by node/setup.sh.
#   fc-node status                 setup progress, then how far behind the network it is
#   fc-node logs                   follow the setup log (Ctrl-C to stop; the node keeps going)
#   fc-node app-account [show|remove]
#                                  let people sign in to fameboy here by approving on
#                                  their phone: saves an account's custody key on this server
#   fc-node client [domain|sslip|off]
#                                  host fameboy here for people who don't run their own:
#                                  https://<app account's name>.<ip>.sslip.io (fameboy.<ip>… without
#                                  one), or your own domain
#   fc-node signin [open|invite]   who can sign in by phone: anyone (open, the default)
#                                  or only people with an invite code
#   fc-node invite [note]          make an invite code for a friend
#   fc-node invite list | revoke <code>
set -uo pipefail
LOG=/var/log/fc-node-setup.log

case "${1:-status}" in
  logs) exec tail -n 30 -F "$LOG" ;;
  status)
    t0=$(date +%s.%N)
    info=$(curl -s -m 5 localhost:3381/v1/info || true)
    if [ -n "$info" ] && echo "$info" | jq -e .shardInfos >/dev/null 2>&1; then
      worst=$(echo "$info" | jq '[.shardInfos[].blockDelay] | max')
      if [ "$worst" -lt 10 ]; then
        echo "$info" | jq -r '.shardInfos | sort_by(.shardId)[] | "  shard \(.shardId): \(.blockDelay)s behind"'
        echo "in sync. Run command 2 on your own computer."
      else
        # Measure the speed rather than assume one: a shard can stop taking
        # blocks (a panic on one block) while blockDelay just keeps growing.
        echo "measuring catch-up speed (10 s)..."
        sleep 10
        t1=$(date +%s.%N)
        info2=$(curl -s -m 5 localhost:3381/v1/info || true)
        if [ -z "$info2" ] || ! echo "$info2" | jq -e .shardInfos >/dev/null 2>&1; then info2=$info; t1=$t0; fi
        jq -nr --argjson a "$info" --argjson b "$info2" --argjson t0 "$t0" --argjson t1 "$t1" '
          def dur: if . < 120 then "\(floor) s" elif . < 7200 then "\(./60 | round) min" else "\((./360 | round) / 10) h" end;
          ($t1 - $t0) as $el
          | ($a.shardInfos | map({key: (.shardId | tostring), value: .}) | from_entries) as $before
          | [$b.shardInfos | sort_by(.shardId)[] | $before[.shardId | tostring] as $p
              | {id: .shardId, d: .blockDelay, h: .maxHeight,
                 moved: (if $p and $el > 0 then .maxHeight - $p.maxHeight else null end),
                 gain: (if $p and $el > 0 then ($p.blockDelay - .blockDelay) / $el else null end)}] as $sh
          | [$sh[] | select(.d >= 10)] as $behind
          | [$behind[] | select(.moved == 0) | .id | tostring] as $stuck
          | ($sh[]
              | if .d < 10 then "  shard \(.id): \(.d)s behind"
                elif .moved == 0 then "  shard \(.id): \(.d | dur) behind and STUCK at block \(.h): no new blocks in \($el | round) s"
                elif .gain == null then "  shard \(.id): \(.d | dur) behind"
                elif .gain <= 0 then "  shard \(.id): \(.d | dur) behind, not gaining (\(.moved) blocks in \($el | round) s)"
                else "  shard \(.id): \(.d | dur) behind, gaining \(.gain * 10 | round / 10) s per second (~\(.d / .gain | dur) to go)" end),
            (if ($stuck | length) > 0 then
               "stuck: shard \($stuck | join(", ")) stopped taking blocks. Restarting will not help if it panicked on one; see why:\n  docker logs snapchain-snapchain-1 2>&1 | grep -A1 panicked\nIf it did, a newer snapchain may fix it: cd ~/snapchain && ./snapchain.sh upgrade"
             elif any($behind[]; .gain == null) then
               "catching up: \([$behind[].d] | max | dur) behind. The node stopped answering, so the speed is unknown; run fc-node status again."
             elif any($behind[]; .gain <= 0) then
               "catching up: \([$behind[].d] | max | dur) behind, not gaining yet. Check again in a few minutes."
             else
               "catching up: \([$behind[].d] | max | dur) behind, ~\([$behind[] | .d / .gain] | max | dur) to go."
             end)'
      fi
      if curl -s -m 3 localhost:3390/v1/companion >/dev/null; then echo "companion: running on port 3390"
      else echo "companion: not running (re-run command 1 to install it)"; fi
      if [ -f /var/lib/fc-fameboy/url ]; then
        if docker ps --format '{{.Names}}' | grep -qx fc-fameboy; then echo "fameboy: hosted at $(cat /var/lib/fc-fameboy/url)"
        else echo "fameboy: set up but not running (fc-node client to restart it; docker logs fc-fameboy)"; fi
      fi
    elif systemctl is-active --quiet fc-node-setup; then
      echo "setup running. Latest:"
      grep -E "shard [0-9]|setup|loaded" "$LOG" | tail -n 2 | sed 's/^/  /'
    else
      echo "the node isn't answering and setup isn't running. Last lines of $LOG:"
      tail -n 15 "$LOG" 2>/dev/null | sed 's/^/  /'
      echo "re-run command 1 to resume."
      exit 1
    fi
    ;;
  app-account)
    # Runs in the fc-companion image, which has viem. The phrase is typed into
    # this terminal and only lives in that container's memory.
    shift
    docker run --rm -it --network host -v /usr/local/lib/fc-companion:/app:ro -v /var/lib/fc-companion:/state \
      node:22-alpine node /app/app-account.mjs "$@" || exit 1
    f=/var/lib/fc-companion/app-account.json
    [ -f "$f" ] && { chown 1000:1000 "$f"; chmod 600 "$f"; }
    # The app account names this node's hosted fameboy and its address.
    case "${1:-}" in show|remove) ;; *)
      if [ -f /var/lib/fc-fameboy/url ]; then
        echo "fameboy is hosted at $(cat /var/lib/fc-fameboy/url). Run fc-node client to move it to an address with the new name."
      else
        echo "Host fameboy for people who don't run their own: fc-node client"
      fi ;;
    esac
    ;;
  client) shift; exec fc-fameboy-install "$@" ;;
  signin)
    f=/var/lib/fc-companion/signin
    case "${2:-}" in
      open) rm -f "$f"; echo "Sign-in is open: anyone can sign in by approving on their phone." ;;
      invite)
        printf 'invite\n' > "$f"; chown 1000:1000 "$f"
        echo "Sign-in needs an invite code now. Make one: fc-node invite"
        echo "People already signed in stay signed in." ;;
      "") if [ "$(cat "$f" 2>/dev/null)" = invite ]; then echo "invite: only people with a code (fc-node invite) can sign in"
          else echo "open: anyone can sign in by approving on their phone (fc-node signin invite to change)"; fi ;;
      *) echo "usage: fc-node signin [open|invite]"; exit 1 ;;
    esac
    ;;
  invite)
    f=/var/lib/fc-companion/invites
    touch "$f"; chown 1000:1000 "$f"; chmod 600 "$f"
    case "${2:-new}" in
      list)
        [ -s "$f" ] || { echo "No invite codes yet. Make one: fc-node invite"; exit 0; }
        awk -F'\t' '{ printf "  %s-%s  %s  %s\n", substr($1,1,4), substr($1,5), $2, $3 }' "$f" ;;
      revoke)
        code=$(echo "${3:-}" | tr -dc 'A-Za-z0-9' | tr a-z A-Z)
        [ -n "$code" ] || { echo "usage: fc-node invite revoke <code>"; exit 1; }
        grep -q "^$code"$'\t' "$f" || { echo "No such code."; exit 1; }
        sed -i "/^$code\t/d" "$f"; echo "Revoked. Signed-in friends stay signed in." ;;
      *)
        code=$(head -c 5 /dev/urandom | base32 | tr -d '=' | head -c 8)
        note="${*:2}"
        printf '%s\t%s\t%s\n' "$code" "$(date -u +%F)" "$note" >> "$f"
        echo "Invite code: ${code:0:4}-${code:4}"
        echo "Friends type it when they sign in with their phone."
        [ "$(cat /var/lib/fc-companion/signin 2>/dev/null)" = invite ] || echo "Sign-in is open, so nobody needs a code yet. To require one: fc-node signin invite"
        [ -f /var/lib/fc-companion/app-account.json ] || echo "Phone sign-in is off until you run: fc-node app-account" ;;
    esac
    ;;
  *) echo "usage: fc-node status | logs | app-account [show|remove] | client [domain|sslip|off] | signin [open|invite] | invite [note|list|revoke <code>]"; exit 1 ;;
esac
