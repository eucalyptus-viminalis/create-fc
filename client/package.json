{
  "name": "fameboy",
  "version": "0.1.0",
  "description": "A minimal Farcaster client that reads from and writes to your own Snapchain node",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fameboy": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fameboy": "node src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "coverage": "node scripts/api-coverage.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@farcaster/core": "0.20.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@scure/bip39": "1.6.0",
    "qrcode": "1.5.4",
    "viem": "2.57.1"
  }
}
